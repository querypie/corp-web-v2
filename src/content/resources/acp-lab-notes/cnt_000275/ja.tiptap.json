        {
          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ],
          "text": "Can Export"
        },
        {
          "type": "text",
          "text": "を有効にした。Can ImportとCan Copy To Clipboardは無効のままだ。"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": " "
        }
      ]
