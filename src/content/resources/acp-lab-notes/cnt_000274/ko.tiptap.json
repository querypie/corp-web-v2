                "class": null,
                "title": null
              }
            }
          ],
          "text": "DAC General Configurations"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": " "
        }
      ]
    }
  ]
}
