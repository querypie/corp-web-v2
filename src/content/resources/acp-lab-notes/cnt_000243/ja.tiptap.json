    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "確認した操作 / 実際の結果"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": " "
        }
