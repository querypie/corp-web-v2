          "text": " "
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "It did not start at zero. Position 1:47 was selected with Action Time 03:59:26, matching the command audit. Playing immediately showed the blocked deletion."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": " "
        }
