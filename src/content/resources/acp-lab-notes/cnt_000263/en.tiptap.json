    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "I opened the blocked rm in Command Audit and clicked Replay under Session Log."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": " "
