    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "I chose the session starting 03:57:38: Operations Lab Operator, SSH Operations Lab, labops. The sessionRecording setting enabled in Part 22 was retained in Part 23."
        }
