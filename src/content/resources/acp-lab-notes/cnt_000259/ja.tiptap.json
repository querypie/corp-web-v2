        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "CSVでもどの承認申請の作業か分かる"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": " "
        }
