        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "ファイル作成前にプレビューする"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": " "
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Generate Previewでは00:05:47の4003参照と00:17:13のUPDATEの2件が出た。どちらもDemo Developer、Orders Control Lab、SUCCESSだった。"
        }
      ]
