      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Using the Screen’s Evidence Directly as Audit Material"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": " "
        }
