      "type": "paragraph"
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": " "
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Scrolling across the record showed Select, Orders Control Lab, host orders-db, and Action By Admin(2). The recipient, database, privileges, and administrator were explicit."
        }
      ]
    },
