          "marks": [
            {
              "type": "link",
              "attrs": {
                "href": "https://docs.querypie.com/ko/administrator-manual/databases/connection-management/db-connections",
                "target": "_blank",
                "rel": "noopener noreferrer nofollow",
                "class": null,
                "title": null
              }
            }
          ],
          "text": "DB Connections"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": " "
        }
      ]
    }
  ]
}
