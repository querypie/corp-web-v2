":"text","marks":[{"type":"bold"}],"text":"現実世界のデータの反映"},{"type":"text","text":":"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"実際の環境では、予期しない新しいデータパターンが頻繁に出現します。"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"これに対処するため、仮想データ生成やデータ拡張技術を活用し、モデルに多様なシナリオを経験させます。"}]}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"例"},{"type":"text","text":": 次のようなデータ "},{"type":"text","marks":[{"type":"code"}],"text":"\"1600 Pennsylvania Avenue NW, Washington, DC 20500\""},{"type":"text","text":" および "},{"type":"text","marks":[{"type":"code"}],"text":"\"1600 Penn Ave, Washington, DC\""},{"type":"text","text":" は、同じ住所の複数の形式をモデルに認識させるために使用されます。"}]}]}]},{"type":"horizontalRule"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"2. 過学習防止手法"}]},{"type":"paragraph","content":[{"type":"text","text":"QueryPie AI分類器は、過学習を防ぎ、汎化性能を向上させるために、以下のような高度な手法を採用しています："}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"早期終了"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"検証パフォーマンス（損失や精度など）が一定期間横ばいになった場合、トレーニングを停止します。"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"例"},{"type":"text","text":": トレーニング中、検証損失が5エポック連続で改善しなかった場合、エポック15でトレーニングが自動的に停止し、過学習を防ぎリソースを節約しました。"}]}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"ドロップアウト"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"トレーニング中に一部のニューロンをランダムに無効化し、特定の特徴への依存を減らし、モデルの堅牢性を向上させます。"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"例"},{"type":"text","text":": 住所分類ネットワークに30%のドロップアウト率を適用することで、モデルは未知の住所形式を効果的に処理できるようになりました。"}]}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"バッチ正規化"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"各層への入力を正規化し、トレーニングプロセスを安定化させ、過学習のリスクを軽減します。"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"例"},{"type":"text","text":": 職業分類タスクに適用したバッチ正規化により、トレーニングの安定性が向上し、最適化が加速しました。"}]}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"データ拡張"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"既存のデータを変換して新しいトレーニングサンプルを作成し、データセットの多様性を高めます。"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"例"},{"type":"text","text":": 変換されました "},{"type":"text","marks":[{"type":"code"}],"text":"\"1600 Pennsylvania Ave\""},{"type":"text","text":" から "},{"type":"text","marks":[{"type":"code"}],"text":"\"1600 Penn Ave\""},{"type":"text","text":" または "},{"type":"text","marks":[{"type":"code"}],"text":"\"John Smith\""},{"type":"text","text":" ～ "},{"type":"text","marks":[{"type":"code"}],"text":"\"J. Smith\""},{"type":"text","text":" モデルにさまざまな表現を処理させるため。"}]}]}]}]}]},{"type":"horizontalRule"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"3. 精度とパフォーマンスの結果"}]},{"type":"paragraph","content":[{"type":"text","text":"AI分類器は、複数の個人データカテゴリにおいて卓越した精度を示します："}]},{"type":"table","content":[{"type":"tableRow","content":[{"type":"tableHeader","attrs":{"colspan":1,"rowspan":1,"colwidth":null},"content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"分類カテゴリ"}]}]},{"type":"tableHeader","attrs":{"colspan":1,"rowspan":1,"colwidth":null},"content":[{"t