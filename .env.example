# DeskPie public API base URL과 API key
# Contact Us Lead와 Community License 발급에서 공용으로 사용
DESKPIE_API_BASE_URL=
DESKPIE_API_KEY=

# Slack 알림 (없으면 Slack 단계 skip)
SLACK_BOT_OAUTH_TOKEN=
SLACK_CHANNEL_ALERT_WEBSITE_BUSINESS_INQUIRIES=
SLACK_CHANNEL_ALERT_WEBSITE_FORM_SUBMISSION_TESTING=

# Google Analytics 4 Measurement ID (예: G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Admin CMS 번역
# 사내 네트워크에서 접근 가능한 Anthropic 호환 번역 API
ANTHROPIC_BASE_URL=http://10.11.0.51:8009
# 인증 토큰은 저장소에 커밋하지 않고 별도로 공유
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_TRANSLATION_MODEL=glm-5.2-fp8
