# DeskPie public API base URL과 API key
# Contact Us Lead와 Community License 발급에서 공용으로 사용
DESKPIE_API_BASE_URL=
DESKPIE_API_KEY=

# Slack 알림 (없으면 Slack 단계 skip)
SLACK_BOT_OAUTH_TOKEN=
SLACK_CHANNEL_ALERT_WEBSITE_BUSINESS_INQUIRIES=
SLACK_CHANNEL_ALERT_WEBSITE_FORM_SUBMISSION_TESTING=

# Google Analytics 4 Measurement ID (예: G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Admin CMS 번역: Preview에서는 아래 사내 기본값을 사용할 수 있습니다.
CMS_TRANSLATION_BASE_URL=https://internal-llm.querypie.io/v1
CMS_TRANSLATION_MODEL=glm-5.3-flash
# 인증이 필요한 별도 서버로 변경할 때만 지정합니다.
CMS_TRANSLATION_API_KEY=

# AI 제품 상담: 모든 환경에서 명시적으로 활성화하고 서버에서 접근 가능한 호환 API를 사용합니다.
AI_CHAT_ENABLED=false
AI_CHAT_BASE_URL=https://internal-llm.querypie.io/v1
AI_CHAT_MODEL=glm-5.3-flash
AI_CHAT_API_KEY=

# AI 제품 상담 RAG 임베딩: GLM 답변 endpoint와 별도의 OpenAI-compatible /embeddings API
AI_CHAT_EMBEDDING_BASE_URL=
AI_CHAT_EMBEDDING_MODEL=bge-m3
AI_CHAT_EMBEDDING_API_KEY=

# AI 제품 상담 운영: PostgreSQL, 익명 요청 제한, 미답변 Slack 보고
AI_CHAT_DATABASE_URL=
AI_CHAT_RATE_LIMIT_SALT=
AI_CHAT_RATE_LIMIT_PER_MINUTE=10
# 미답변 조회 전용 32바이트 이상 무작위 키. NEXT_PUBLIC_ 접두사나 URL에 넣지 않습니다.
AI_CHAT_REPORT_API_KEY=
CRON_SECRET=
SLACK_USER_ALERT_AI_CHAT_UNANSWERED=
SLACK_CHANNEL_ALERT_AI_CHAT_UNANSWERED_TESTING=
