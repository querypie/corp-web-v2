# DeskPie public API base URL과 API key
# Contact Us Lead와 Community License 발급에서 공용으로 사용
DESKPIE_API_BASE_URL=
DESKPIE_API_KEY=

# Slack 알림 (없으면 Slack 단계 skip)
SLACK_BOT_OAUTH_TOKEN=
SLACK_CHANNEL_ALERT_WEBSITE_BUSINESS_INQUIRIES=
SLACK_CHANNEL_ALERT_WEBSITE_FORM_SUBMISSION_TESTING=

# Google Analytics 4 Measurement ID (예: G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Vercel Preview는 서버 코드의 사내 AI 기본값을 사용하므로 아래 값 등록이 필수가 아닙니다.
# 아래 환경변수를 명시하면 코드 기본값보다 우선합니다.
# Admin CMS 번역: 사내 키 없는 API (레거시 ANTHROPIC_* / OPENAI_* 설정보다 우선)
CMS_TRANSLATION_BASE_URL=https://internal-llm.querypie.io/v1
CMS_TRANSLATION_MODEL=glm-5.3-flash
# 인증이 필요한 별도 서버로 변경할 때만 지정합니다.
CMS_TRANSLATION_API_KEY=

# AI 제품 상담 테스트: 사내망/VPN에서 사용하는 키 없는 호환 API
# Preview는 기본 활성화됩니다. false로 끌 수 있으며 그 외 환경은 true로 켜야 합니다.
AI_CHAT_ENABLED=false
AI_CHAT_BASE_URL=https://internal-llm.querypie.io/v1
AI_CHAT_MODEL=glm-5.3-flash
# 다른 인증 서버를 사용할 때만 지정합니다.
AI_CHAT_API_KEY=
