# corp-web-v2 Staging lead form environment
#
# Purpose:
# - Contact Us: /api/contact-us -> DeskPie Lead API best-effort + Slack best-effort
# - Gating form: /api/downloads/content -> Slack best-effort
# - Community License: /api/community-license -> License issue API + Slack
#
# Add these values to the Vercel project `corp-web-v2` Staging custom environment.
# Do not commit a filled file containing real secrets.

# Required for Slack notifications from Contact Us, Gating forms, and Community License.
# Ask for the existing QueryPie Corp-Web Slack app bot token.
# Expected format: xoxb-...
SLACK_BOT_OAUTH_TOKEN=

# Slack channel ID where lead form notifications should be posted.
# Current documented staging/testing channel:
#   C083Y0300M7  #alert-website-form-submission-testing
# Previous production business inquiry channel shown in Slack:
#   C08JNAZDU5A  #alert-website-business-inquiries
#
# Choose one channel intentionally. If the app is not invited to the private channel,
# Slack postMessage can fail even when the token and channel ID are correct.
SLACK_CHANNEL_ALERT_WEBSITE_BUSINESS_INQUIRIES=C083Y0300M7

# Optional explicit non-production override. The app uses this first when
# VERCEL_TARGET_ENV is not "production".
SLACK_CHANNEL_ALERT_WEBSITE_FORM_SUBMISSION_TESTING=C083Y0300M7

# Required if Contact Us submissions should create DeskPie leads.
# Example local endpoint: http://localhost:8011/api/v1/public/leads
DESKPIE_LEAD_API_ENDPOINT=
DESKPIE_LEAD_API_KEY=

# Required only for Community License automatic license issuance.
# Staging currently uses the same public license endpoint as production.
QUERYPIE_LICENSE_ISSUE_API_ENDPOINT=https://license.querypie.com/license/community
QUERYPIE_LICENSE_ISSUE_API_KEY=
